<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    An adapter for a capability the domain declares a need for. Its store functions satisfy
    LoadCredentials, SaveCredential and UpdateCredential; the composition root binds them.

    No Repositories/ or UseCases/ layer: those were the per-layer DTO hops this architecture
    replaces. New adapter code goes beside Database/, named for what it talks to.
  -->
  <ItemGroup>
    <Compile Include="Database\Types\CredentialsDatabaseContext.fs" />
    <Compile Include="Database\CredentialsDatabaseContextModule.fs" />
    <Compile Include="CredentialEntityMappers.fs" />
    <Compile Include="CredentialStore.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LiteDB" Version="5.0.21" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MyDogsbody.Builders\MyDogsbody.Builders.fsproj" />
    <ProjectReference Include="..\MyDogsbody.Integrations.Credentials.Database.Models\MyDogsbody.Integrations.Credentials.Database.Models.csproj" />
    <ProjectReference Include="..\MyDogsbody.Domain\MyDogsbody.Domain.fsproj" />
  </ItemGroup>

</Project>
