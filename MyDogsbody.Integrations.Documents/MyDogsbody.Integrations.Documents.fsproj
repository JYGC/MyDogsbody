<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!--
      An adapter for a capability the domain declares a need for. PdfDocumentReader satisfies
      ReadDocumentContent; the line grouping it used to wrap is now a domain workflow.
    -->
    <Compile Include="PdfDocumentReader.fs" />
    <Compile Include="WordDocumentReader.fs" />
  </ItemGroup>

    <ItemGroup>
        <PackageReference Include="PdfPig" Version="0.1.11" />
        <PackageReference Include="DocumentFormat.OpenXml" Version="3.1.1" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\MyDogsbody.Builders\MyDogsbody.Builders.fsproj" />
        <ProjectReference Include="..\MyDogsbody.Domain\MyDogsbody.Domain.fsproj" />
    </ItemGroup>

</Project>
