<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Throwaway measurement harness for docs/changes/invoice-extraction tasks 12.4 and 12.5.
    NOT in MyDogsbody.sln on purpose: the gate never touches it. Delete this project, and
    measure.db / Thunderbird.db / Logging.db from the repo root, once outcome.md has the numbers.
    Run it from the repo root with: dotnet run  (see README.md in this folder).
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <WarningLevel>0</WarningLevel>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MyDogsbody.Startup\MyDogsbody.Startup.fsproj" />
  </ItemGroup>

</Project>
