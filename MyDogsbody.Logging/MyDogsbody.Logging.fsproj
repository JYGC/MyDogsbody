<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    Cross-cutting infrastructure, not an integration: no workflow declares a need for it, it
    holds no domain data, and nothing reads from it at runtime. Its only non-scratch consumer is
    MyDogsbody.Startup, which partially applies addException into handleError's writeLog.

    One record for the whole component rather than one DTO per layer - see Types/ExceptionLogEntry.fs.
  -->
  <ItemGroup>
    <Compile Include="Types\ExceptionLogEntry.fs" />
    <Compile Include="Database\Types\LoggingDatabaseContext.fs" />
    <Compile Include="Database\LoggingDatabaseContextModule.fs" />
    <Compile Include="Repositories\ExceptionRepository.fs" />
    <Compile Include="UseCases\ExceptionUseCases.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LiteDB" Version="5.0.21" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MyDogsbody.Builders\MyDogsbody.Builders.fsproj" />
    <ProjectReference Include="..\MyDogsbody.Exceptions.Types\MyDogsbody.Exceptions.Types.fsproj" />
    <ProjectReference Include="..\MyDogsbody.Logging.Database.Models\MyDogsbody.Logging.Database.Models.csproj" />
  </ItemGroup>

</Project>
