<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    The Google integration's LiteDB entity classes. C# because LiteDB needs settable
    properties and ObjectId. No MyDogsbody.Enums reference: the database is the provider,
    so there is no discriminator to share.
  -->
  <ItemGroup>
    <PackageReference Include="LiteDB" Version="5.0.21" />
  </ItemGroup>

</Project>
