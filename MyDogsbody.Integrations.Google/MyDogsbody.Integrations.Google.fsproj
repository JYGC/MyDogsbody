<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    An adapter for a capability the domain declares a need for. Today it holds only the Google
    credential store; change #6 adds the account store and the calendar client beside it.

    No Repositories/ or UseCases/ layer, and no MyDogsbody.Domain reference: a credential is not
    a domain concept, so the constrained types live here.
  -->
  <ItemGroup>
    <Compile Include="GoogleCredentialTypes.fs" />
    <Compile Include="Database\Types\GoogleDatabaseContext.fs" />
    <Compile Include="GoogleCredentialEntityMappers.fs" />
    <Compile Include="Database\GoogleDatabaseContextModule.fs" />
    <Compile Include="GoogleCredentialStore.fs" />
    <Compile Include="GoogleCalendar.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Apis.Auth" Version="1.72.0" />
    <PackageReference Include="Google.Apis.Calendar.v3" Version="1.69.0.3746" />
    <PackageReference Include="LiteDB" Version="5.0.21" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MyDogsbody.Builders\MyDogsbody.Builders.fsproj" />
    <ProjectReference Include="..\MyDogsbody.Exceptions.Types\MyDogsbody.Exceptions.Types.fsproj" />
    <ProjectReference Include="..\MyDogsbody.Integrations.Google.Database.Models\MyDogsbody.Integrations.Google.Database.Models.csproj" />
  </ItemGroup>

</Project>
