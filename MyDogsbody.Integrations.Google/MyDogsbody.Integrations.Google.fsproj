<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    An adapter for a capability the domain declares a need for. GoogleCredentialTypes /
    GoogleCredentialStore stay credential-only (Q3.7: a credential is not a domain concept, so
    those types live here rather than in MyDogsbody.Domain). Everything change #6 adds -
    GoogleEntityMappers, GoogleAccountStore, GoogleAuthorization, GoogleCalendarClient -
    satisfies a MyDogsbody.Domain.Calendar dependency function type, which is what earns this
    project its first MyDogsbody.Domain reference.
  -->
  <ItemGroup>
    <Compile Include="GoogleCredentialTypes.fs" />
    <Compile Include="Database\Types\GoogleDatabaseContext.fs" />
    <Compile Include="GoogleCredentialEntityMappers.fs" />
    <Compile Include="GoogleEntityMappers.fs" />
    <Compile Include="Database\GoogleDatabaseContextModule.fs" />
    <Compile Include="GoogleCredentialStore.fs" />
    <Compile Include="GoogleAccountStore.fs" />
    <Compile Include="GoogleCredentialDataStore.fs" />
    <Compile Include="GoogleAuthorization.fs" />
    <Compile Include="GoogleCalendarClient.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Apis.Auth" Version="1.72.0" />
    <PackageReference Include="Google.Apis.Calendar.v3" Version="1.69.0.3746" />
    <PackageReference Include="LiteDB" Version="5.0.21" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MyDogsbody.Builders\MyDogsbody.Builders.fsproj" />
    <ProjectReference Include="..\MyDogsbody.Exceptions.Types\MyDogsbody.Exceptions.Types.fsproj" />
    <ProjectReference Include="..\MyDogsbody.Domain\MyDogsbody.Domain.fsproj" />
    <ProjectReference Include="..\MyDogsbody.Integrations.Google.Database.Models\MyDogsbody.Integrations.Google.Database.Models.csproj" />
  </ItemGroup>

</Project>
