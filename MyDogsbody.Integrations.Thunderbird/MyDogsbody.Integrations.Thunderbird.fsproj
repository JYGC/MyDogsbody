<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    An adapter for a capability the domain declares a need for. Its store functions and readers
    satisfy the MailAccounts dependency function types; the composition root binds them.

    No Repositories/ or UseCases/ layer: those were the per-layer DTO hops this architecture
    replaces. New adapter code goes beside Database/, named for what it talks to.
  -->
  <ItemGroup>
    <Compile Include="ThunderbirdFolderScanner.fs" />
    <Compile Include="ThunderbirdAccountReader.fs" />
    <Compile Include="MailFolderEnumerator.fs" />
    <Compile Include="MailFolderReader.fs" />
    <Compile Include="Database\Types\ThunderbirdDatabaseContext.fs" />
    <Compile Include="Database\ThunderbirdDatabaseContextModule.fs" />
    <Compile Include="ThunderbirdEntityMappers.fs" />
    <Compile Include="ThunderbirdStore.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LiteDB" Version="5.0.21" />
    <PackageReference Include="MimeKit" Version="4.17.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MyDogsbody.Builders\MyDogsbody.Builders.fsproj" />
    <ProjectReference Include="..\MyDogsbody.Exceptions.Types\MyDogsbody.Exceptions.Types.fsproj" />
    <ProjectReference Include="..\MyDogsbody.Integrations.Thunderbird.Database.Models\MyDogsbody.Integrations.Thunderbird.Database.Models.csproj" />
    <ProjectReference Include="..\MyDogsbody.Domain\MyDogsbody.Domain.fsproj" />
  </ItemGroup>

</Project>
